<Window x:Class="Beam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beam" Width="1100" Height="780" MinWidth="900" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        Icon="pack://application:,,,/Assets/Beam.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,6,20,0">
                    <Image Source="pack://application:,,,/Assets/Logo.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Margin="11,0,0,1" Text="Beam" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,4,12,12">
                    <StackPanel>
                        <Grid Margin="10,0,4,6">
                            <TextBlock x:Name="ProjectsLabel" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                            <Button x:Name="AddButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Width="28" Height="28"
                                    FontSize="11" Content="&#xE710;" Click="OnAddProject"/>
                        </Grid>
                        <StackPanel x:Name="ProjectList"/>

                        <StackPanel x:Name="RecentSection" Margin="0,20,0,0">
                            <TextBlock x:Name="RecentLabel" Style="{StaticResource Overline}" Margin="10,0,0,8"/>
                            <StackPanel x:Name="RecentList"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,1,0,0" Padding="10,8">
                    <Grid>
                        <Button x:Name="LangButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnToggleLanguage">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="13"/>
                                <TextBlock x:Name="LangText" Margin="9,0,0,0" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border x:Name="GlobalPill" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" Padding="9,4">
                            <StackPanel Orientation="Horizontal">
                                <Grid x:Name="GlobalDotHost" Width="8" Height="8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GlobalText" Margin="7,0,0,0" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.7" RadiusY="0.55">
                        <GradientStop Color="#1FFF8A45" Offset="0"/>
                        <GradientStop Color="#00FF8A45" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Content="&#xE922;" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>

            <Grid x:Name="EmptyView" Grid.Row="1" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="32,0,32,70">
                    <Grid Width="112" Height="112" HorizontalAlignment="Center">
                        <Ellipse Width="150" Height="150" Fill="#FF8A45" Opacity="0.2" Margin="-19">
                            <Ellipse.Effect>
                                <BlurEffect Radius="64"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Image Source="pack://application:,,,/Assets/Logo.png" Width="104" Height="104" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <TextBlock x:Name="EmptyTitle" Margin="0,28,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="EmptyBody" Margin="0,10,0,0" FontSize="14" Foreground="{StaticResource Muted}" TextAlignment="Center"
                               TextWrapping="Wrap" LineHeight="22"/>
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,28,0,0" Click="OnBrowse">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" FontSize="15"/>
                            <TextBlock x:Name="EmptyButtonText" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <WrapPanel x:Name="EmptyRecent" HorizontalAlignment="Center" Margin="0,24,0,0"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="ProjectView" Grid.Row="1" Margin="36,0,36,28">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ContentShift"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="130"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ProjectName" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="ProjectPath" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Faint}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="440" FlowDirection="LeftToRight"/>
                            <Button x:Name="OpenFolderButton" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11"
                                    Margin="6,0,0,0" Content="&#xE8A7;" Click="OnOpenFolder"/>
                            <Button x:Name="ChangeButton" Style="{StaticResource GhostButton}" FontSize="12" Padding="8,4" Margin="2,0,0,0" Click="OnBrowse"/>
                        </StackPanel>
                        <WrapPanel x:Name="Chips" Margin="0,12,0,0"/>
                    </StackPanel>
                    <Button x:Name="StopButton" Grid.Column="1" Style="{StaticResource DangerButton}" VerticalAlignment="Top" Margin="20,6,0,0"
                            Visibility="Collapsed" Click="OnMain">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12"/>
                            <TextBlock x:Name="StopText" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border x:Name="HeroCard" Grid.Row="1" CornerRadius="20" BorderThickness="1" Margin="0,0,0,16">
                    <Grid x:Name="HeroLayer">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Canvas Grid.RowSpan="2" IsHitTestVisible="False">
                            <Rectangle x:Name="HeroBeam" Width="240" Height="1000" Canvas.Top="-400" Canvas.Right="40" Opacity="0.5" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="42"/>
                                </Rectangle.RenderTransform>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#00FF8A45" Offset="0"/>
                                        <GradientStop Color="#33FF8A45" Offset="0.42"/>
                                        <GradientStop Color="#4DFFC05C" Offset="0.5"/>
                                        <GradientStop Color="#33FF8A45" Offset="0.58"/>
                                        <GradientStop Color="#00FF8A45" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Canvas>

                        <Grid Margin="28,26" MinHeight="124">
                            <Grid x:Name="HeroIdle" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="HeroTitle" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="HeroBody" Margin="0,6,0,0" FontSize="13.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21"/>
                                    <Border x:Name="ProgressTrack" Margin="0,16,0,0" Height="3" CornerRadius="1.5" Background="{StaticResource SurfaceHover}"
                                            ClipToBounds="True" HorizontalAlignment="Stretch" MaxWidth="420" Visibility="Collapsed" FlowDirection="LeftToRight">
                                        <Border x:Name="ProgressBar" Width="140" HorizontalAlignment="Left" CornerRadius="1.5" Background="{StaticResource AccentGradient}">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="ProgressShift"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Border>
                                </StackPanel>
                                <Button x:Name="GoLiveButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="24,0,0,0"
                                        MinWidth="160" Click="OnMain">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13"/>
                                        <TextBlock x:Name="GoLiveText" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid x:Name="HeroLive" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{StaticResource SuccessSoft}" CornerRadius="10" Padding="10,3,11,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Grid x:Name="LiveDotHost" Width="8" Height="8" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="LiveBadgeText" Margin="8,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Success}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="ElapsedText" Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LinkText" Margin="0,12,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"
                                               TextWrapping="Wrap" FlowDirection="LeftToRight" HorizontalAlignment="Left" Cursor="Hand"
                                               MouseLeftButtonUp="OnOpenLink"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button x:Name="CopyButton" Style="{StaticResource PrimaryButton}" Padding="18,9" FontSize="13" Click="OnCopy" MinWidth="108">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="CopyIcon" Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12"/>
                                                <TextBlock x:Name="CopyText" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SoftButton}" Click="OnOpenLink" Margin="10,0,0,0" MinWidth="96">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12"/>
                                                <TextBlock x:Name="OpenText" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="LinkHint" Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource Faint}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="9" Margin="24,0,0,0" VerticalAlignment="Center">
                                    <Image x:Name="QrImage" Width="126" Height="126" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                            </Grid>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,1,0,0" Padding="24,14">
                            <Grid x:Name="StepsGrid"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1" Padding="18,6,8,6">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" FontSize="13" Foreground="{StaticResource Faint}"/>
                                    <TextBlock x:Name="LogsTitle" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="CopyLogButton" Style="{StaticResource IconButton}" Content="&#xE8C8;" FontSize="12" Click="OnCopyLog"/>
                                    <Button x:Name="ClearLogButton" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="12" Click="OnClearLogs"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" Padding="18,12,18,14"/>
                            <TextBlock x:Name="LogEmpty" FontSize="12.5" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
